# SRYN PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)

# -----------------------------------------------------------------------------
# 1. PUBLIC FIREBASE WEB CONFIGURATION (Exposed to Client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=srynportal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=srynportal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=srynportal.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# 2. OFFICIAL PRODUCTION DOMAINS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CORPORATE_URL=https://www.sryn.online
NEXT_PUBLIC_TECHNOLOGY_URL=https://technology.sryn.online
NEXT_PUBLIC_FINSERV_URL=https://finserv.sryn.online
NEXT_PUBLIC_RECRUITMENT_URL=https://recruitment.sryn.online
NEXT_PUBLIC_ADMIN_URL=https://admin.sryn.online

# -----------------------------------------------------------------------------
# 3. PRIVATE SERVER-SIDE SECRETS (NEVER EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@srynportal.iam.gserviceaccount.com"

# Email Provider Secrets (Resend / SendGrid / SMTP)
RESEND_API_KEY=re_123456789
SENDGRID_API_KEY=SG.123456789
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@sryn.online
SMTP_PASS=your_smtp_password

# WhatsApp Cloud API / Twilio Secrets
WHATSAPP_CLOUD_API_KEY=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# SMS Provider Secrets (MSG91 / Twilio)
MSG91_AUTH_KEY=your_msg91_key
TWILIO_SMS_KEY=your_twilio_sms_key

# Payment Gateway Secrets (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_live_123456789
RAZORPAY_KEY_SECRET=your_razorpay_secret
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret
